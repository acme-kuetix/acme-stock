// POST /stock/moves — create a draft stock move (header only).
// JSON body: {reference?, sourceId, destinationId, scheduledAt?, origin?, note?}
// If reference is empty/missing, one is auto-assigned via sequence/sequence.NextByCode
// (code: "stock-move", prefix "SM-", padding 4 → e.g. "SM-0001").
// The move id and reference are both the formatted sequence value — matches
// the prior pattern where NextStockMoveId and NextStockMoveReference returned
// the same counter value formatted as "SM-NNNN".
// Caller-supplied references are not currently honored (would require a Go
// helper or engine ?? fix to detect missing vs empty $json.reference).
// Lines are added separately via /stock/moves/{moveId}/lines.
// Provided by acme-stock package.
//
// Per-state failure handlers: each errorable state routes to its own
// <StateName>Failed terminal state with a LITERAL statusCode (chosen per
// failure type) and $Alias.response.message for the message. Avoids the
// WSL ?? operator which doesn't work for $Alias.field??literal when the
// alias exists but the field is missing (tokenSegmentClass includes ?),
// and avoids $? which is overwritten by worker.SetError to 500 on every
// error path.

module stock_move_create

import persistence/store
import sequence/sequence
import services/common

workflow stock_move_create {
  start: GetId

  state GetId {
    action sequence/sequence.NextByCode(code: "stock-move", scope: "") as IdResult
    on success -> Create
    on error -> GetIdFailed
  }

  state Create {
    action persistence/store/store.Create(
      collection: "stock_moves",
      id: $IdResult.response.formatted,
      doc: {
        id: $IdResult.response.formatted,
        reference: $IdResult.response.formatted,
        sourceId: $json.sourceId,
        destinationId: $json.destinationId,
        state: "draft",
        scheduledAt: $json.scheduledAt??"",
        origin: $json.origin??"",
        note: $json.note??"",
        lines: [],
        createdAt: "",
        updatedAt: ""
      }
    ) as Result
    on success -> OK
    on error -> CreateFailed
  }

  state OK {
    action services/common/response.Response(
      value: $Result.response.doc,
      statusCode: 201
    ) as FinalResult
    end ok
  }

  state GetIdFailed {
    action services/common/response.Response(
      value: { message: $IdResult.response.message, code: "create_failed" },
      statusCode: 500
    ) as ErrorResult
    end fail
  }

  state CreateFailed {
    action services/common/response.Response(
      value: { message: $Result.response.message, code: $Result.response.code },
      statusCode: 500
    ) as ErrorResult
    end fail
  }
}
