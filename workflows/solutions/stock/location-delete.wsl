// DELETE /stock/locations/{locationId} — delete a location.
// Fails if the location has children (tree integrity enforced by
// persistence/store.AssertNoChildren).
// Provided by acme-stock package.
//
// Per-state failure handlers: each errorable state routes to its own
// <StateName>Failed terminal state with a LITERAL statusCode (chosen per
// failure type) and $Alias.response.message for the message. Avoids the
// WSL ?? operator which doesn't work for $Alias.field??literal when the
// alias exists but the field is missing (tokenSegmentClass includes ?),
// and avoids $? which is overwritten by worker.SetError to 500 on every
// error path.

module stock_location_delete

import persistence/store
import services/common

workflow stock_location_delete {
  start: CheckChildren

  state CheckChildren {
    action persistence/store/store.AssertNoChildren(
      collection: "stock_locations",
      field: "parentId",
      value: $url.locationId,
      filterField: "",
      filterValue: ""
    ) as NoChildren
    on success -> Delete
    on error -> CheckChildrenFailed
  }

  state Delete {
    action persistence/store/store.Delete(
      collection: "stock_locations",
      id: $url.locationId
    ) as Result
    on success -> OK
    on error -> DeleteFailed
  }

  state OK {
    action services/common/response.Response(
      value: { id: $url.locationId, deleted: true },
      statusCode: 200
    ) as FinalResult
    end ok
  }

  state CheckChildrenFailed {
    action services/common/response.Response(
      value: { message: $NoChildren.response.message, code: $NoChildren.response.code },
      statusCode: 409
    ) as ErrorResult
    end fail
  }

  state DeleteFailed {
    action services/common/response.Response(
      value: { message: $Result.response.message, code: $Result.response.code },
      statusCode: 500
    ) as ErrorResult
    end fail
  }
}
