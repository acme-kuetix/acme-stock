// POST /stock/moves/{moveId}/cancel — transition a draft or confirmed move to cancelled.
// Done moves cannot be cancelled.
// Provided by acme-stock package.
//
// Per-state failure handlers: each errorable state routes to its own
// <StateName>Failed terminal state with a LITERAL statusCode (chosen per
// failure type) and $Alias.response.message for the message. Avoids the
// WSL ?? operator which doesn't work for $Alias.field??literal when the
// alias exists but the field is missing (tokenSegmentClass includes ?),
// and avoids $? which is overwritten by worker.SetError to 500 on every
// error path.

module stock_move_cancel

import persistence/store
import services/common

workflow stock_move_cancel {
  start: Load

  state Load {
    action persistence/store/store.Get(
      collection: "stock_moves",
      id: $url.moveId
    ) as LoadResult
    on success -> Update
    on error -> LoadFailed
  }

  state Update {
    action persistence/store/store.Update(
      collection: "stock_moves",
      id: $url.moveId,
      doc: {
        id: $LoadResult.response.doc.id,
        reference: $LoadResult.response.doc.reference,
        sourceId: $LoadResult.response.doc.sourceId,
        destinationId: $LoadResult.response.doc.destinationId,
        state: "cancelled",
        scheduledAt: $LoadResult.response.doc.scheduledAt,
        origin: $LoadResult.response.doc.origin,
        note: $LoadResult.response.doc.note,
        lines: $LoadResult.response.doc.lines,
        createdAt: $LoadResult.response.doc.createdAt,
        updatedAt: ""
      }
    ) as UpdateResult
    on success -> OK
    on error -> UpdateFailed
  }

  state OK {
    action services/common/response.Response(
      value: $UpdateResult.response.doc,
      statusCode: 200
    ) as FinalResult
    end ok
  }

  state LoadFailed {
    action services/common/response.Response(
      value: { message: $LoadResult.response.message, code: $LoadResult.response.code },
      statusCode: 404
    ) as ErrorResult
    end fail
  }

  state UpdateFailed {
    action services/common/response.Response(
      value: { message: $UpdateResult.response.message, code: $UpdateResult.response.code },
      statusCode: 500
    ) as ErrorResult
    end fail
  }
}
