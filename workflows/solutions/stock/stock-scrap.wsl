// POST /stock/scrap — scrap (write off) stock at a location.
// JSON body: {productId, locationId, qty, reason}.
// Reduces the on-hand qty at the location by the scrapped amount, records a
// stock_adjustment doc with type "scrap", and keeps the audit trail.
// Provided by acme-stock package.

module stock_scrap

import core/orchestration
import core/utils
import math/ops
import persistence/store
import sequence/sequence
import services/common

workflow stock_scrap {
  start: FindExistingStock

  state FindExistingStock {
    action persistence/store/store.FindByField(
      collection: "stock_levels",
      field: "productId",
      value: $json.productId
    ) as FindResult
    on success -> CheckFound
    on error -> FindFailed
  }

  state CheckFound {
    action services/common/response.Response(
      value: { found: $FindResult.response.found },
      statusCode: 200
    ) as FoundCheck
    on success when $FoundCheck.response.found == true -> LoadStockLevel
    on success -> ScrapFailedNoStock
    on error -> CheckFoundFailed
  }

  state LoadStockLevel {
    action persistence/store/store.Get(
      collection: "stock_levels",
      id: $FindResult.response.doc.id
    ) as StockResult
    on success -> CheckQtyAvailable
    on error -> LoadStockLevelFailed
  }

  state CheckQtyAvailable {
    action math/ops/ops.Sub(
      a: $StockResult.response.doc.qtyOnHand,
      b: $json.qty
    ) as AfterScrapResult
    on success -> AssertNonNegative
    on error -> CheckQtyFailed
  }

  state AssertNonNegative {
    action math/ops/ops.AssertPositive(
      value: $AfterScrapResult.response.result,
      code: "scrap_insufficient",
      message: "insufficient stock to scrap"
    ) as AssertResult
    on success -> CreateAdjustment
    on error -> ScrapFailedInsufficient
  }

  state CreateAdjustment {
    action sequence/sequence.NextByCode(code: "stock-adjustment", scope: "") as AdjSeq
    on success -> CreateAdjustmentDoc
    on error -> CreateAdjustmentFailed
  }

  state CreateAdjustmentDoc {
    action persistence/store/store.Create(
      collection: "stock_adjustments",
      id: $AdjSeq.response.formatted,
      doc: {
        id: $AdjSeq.response.formatted,
        productId: $json.productId,
        locationId: $json.locationId,
        delta: $json.qty,
        reason: $json.reason??"scrap",
        type: "scrap",
        createdAt: "now"
      }
    ) as AdjResult
    on success -> StashAdjDoc
    on error -> CreateAdjustmentDocFailed
  }

  state StashAdjDoc {
    action core/utils/utils.SetValue(
      key: "adj.doc",
      value: $AdjResult.response.doc
    ) as StashedAdj
    on success -> UpdateStockLevel
    on error -> UpdateStockLevel
  }

  state UpdateStockLevel {
    action persistence/store/store.Update(
      collection: "stock_levels",
      id: $StockResult.response.doc.id,
      doc: {
        id: $StockResult.response.doc.id,
        productId: $json.productId,
        locationId: $json.locationId,
        qtyOnHand: $AfterScrapResult.response.result,
        reservedQty: $StockResult.response.doc.reservedQty,
        createdAt: $StockResult.response.doc.createdAt,
        updatedAt: "now"
      }
    ) as UpdateResult
    on success -> SetAuditData
    on error -> UpdateStockLevelFailed
  }

  state SetAuditData {
    action core/utils/utils.SetValue(
      key: "audit.eventData",
      value: {
        actor: $json.actor??"",
        workflow: "stock-scrap",
        state: "Scrapped",
        transition: "StockScrap",
        entityType: "stock_adjustment",
        entityId: $AdjSeq.response.formatted,
        before: $StockResult.response.doc,
        after: $StashedAdj.response.value,
        success: true
      }
    ) as AuditData
    on success -> RecordAudit
    on error -> OK
  }

  state RecordAudit {
    action core/orchestration/orchestration.RunWorkflow(name: "solutions/audit/record") as AuditResult
    on success -> OK
    on error -> OK
  }

  state OK {
    action services/common/response.Response(
      value: $StashedAdj.response.value,
      statusCode: 201
    ) as FinalResult
    end ok
  }

  state FindFailed {
    action services/common/response.Response(
      value: { message: $FindResult.response.message, code: "scrap_failed" },
      statusCode: 500
    ) as ErrorResult
    end fail
  }

  state CheckFoundFailed {
    action services/common/response.Response(
      value: { message: "failed to check stock level", code: "scrap_failed" },
      statusCode: 500
    ) as ErrorResult
    end fail
  }

  state ScrapFailedNoStock {
    action services/common/response.Response(
      value: { message: "no stock level found for product", code: "scrap_no_stock" },
      statusCode: 404
    ) as ErrorResult
    end fail
  }

  state LoadStockLevelFailed {
    action services/common/response.Response(
      value: { message: $StockResult.response.message, code: "scrap_failed" },
      statusCode: 500
    ) as ErrorResult
    end fail
  }

  state CheckQtyFailed {
    action services/common/response.Response(
      value: { message: $AfterScrapResult.response.message, code: "scrap_failed" },
      statusCode: 500
    ) as ErrorResult
    end fail
  }

  state ScrapFailedInsufficient {
    action services/common/response.Response(
      value: { message: "insufficient stock to scrap", code: "scrap_insufficient" },
      statusCode: 409
    ) as ErrorResult
    end fail
  }

  state CreateAdjustmentFailed {
    action services/common/response.Response(
      value: { message: $AdjSeq.response.message, code: "scrap_failed" },
      statusCode: 500
    ) as ErrorResult
    end fail
  }

  state CreateAdjustmentDocFailed {
    action services/common/response.Response(
      value: { message: $AdjResult.response.message, code: "scrap_failed" },
      statusCode: 500
    ) as ErrorResult
    end fail
  }

  state UpdateStockLevelFailed {
    action services/common/response.Response(
      value: { message: $UpdateResult.response.message, code: "scrap_failed" },
      statusCode: 500
    ) as ErrorResult
    end fail
  }
}
