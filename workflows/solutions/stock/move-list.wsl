// GET /stock/moves — list moves, optionally filtered by ?state=draft|confirmed|done|cancelled and/or ?sourceId=.
// Provided by acme-stock package.

module stock_move_list

import persistence/store
import services/common

workflow stock_move_list {
  start: List

  state List {
    action persistence/store/store.List(
      collection: "stock_moves",
      filter: {}
    ) as Result
    on success -> OK
  }

  state OK {
    action services/common/response.Response(
      value: { count: $Result.response.count, items: $Result.response.docs },
      statusCode: 200
    ) as FinalResult
    end ok
  }
}
